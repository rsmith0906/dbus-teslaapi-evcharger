  {
    "id": "tesla_start_policy",
    "type": "function",
    "z": "2ea0df98a5ef77d5",
    "name": "Start rules: >50% OR >=20% + >1600 W",
    "x": 790,
    "y": 400,
    "wires": [
      [
        "tesla_save_session"
      ]
    ],
    "func": "// ALL start rules live here. Change thresholds here, not in Python.\nconst BATTERY_ONLY_SOC = 50;   // strictly above\nconst SOLAR_MIN_SOC = 20;      // at least\nconst SOLAR_WATTS = 1600;      // strictly above\nconst MAX_CACHE_AGE_SECONDS = 15 * 60;\nconst input = msg.payload;\nconst charge = input.charge || {};\nconst now = Date.now() / 1000;\nfunction wait(reason) {\n    node.status({fill: \"grey\", shape: \"ring\", text: reason});\n    return null;\n}\nconst state = input.session === null ? {handled: false} : input.session;\nif (!state || typeof state.handled !== \"boolean\") {\n    node.error(\"Invalid saved session state; no start sent\", msg);\n    return null;\n}\nconst times = [Number(input.cacheMtime)];\nif (charge.timestamp !== null && charge.timestamp !== undefined) times.push(Number(charge.timestamp)/1000);\nif (input.cacheMtime == null || times.some(t => !Number.isFinite(t) || now-t < 0 || now-t > MAX_CACHE_AGE_SECONDS)) return wait(\"Waiting for fresh Tesla cache\");\nlet next = state;\nmsg.startRequested = false;\nif (charge.charging_state === \"Disconnected\") {\n    next = {handled: false};\n    node.status({fill: \"grey\", shape: \"ring\", text: \"Unplugged: rearmed\"});\n} else if ([\"Charging\", \"Complete\"].includes(charge.charging_state)) {\n    next = {handled: true};\n    node.status({fill: \"green\", shape: \"dot\", text: charge.charging_state});\n} else {\n    if (state.handled) return wait(\"Already handled this plug-in session\");\n    if (charge.charging_state !== \"Stopped\" || charge.charge_port_latch !== \"Engaged\") return wait(\"Car not ready / not plugged in\");\n    const p = flow.get(\"teslaEnergy\") || {};\n    if (p.BatterySOC == null || p.PVPower == null || p.BatterySOC === \"\" || p.PVPower === \"\") return wait(\"Missing house readings\");\n    const soc = Number(p.BatterySOC), solar = Number(p.PVPower);\n    if (!Number.isFinite(soc) || soc < 0 || soc > 100 || !Number.isFinite(solar) || solar < 0) return wait(\"Invalid house readings\");\n    if (!(soc > BATTERY_ONLY_SOC || (soc >= SOLAR_MIN_SOC && solar > SOLAR_WATTS))) return wait(\"Waiting for battery or solar\");\n    next = {handled: true, attempted_at: now};\n    msg.startRequested = true;\n    node.status({fill: \"yellow\", shape: \"dot\", text: \"Saving attempt before start\"});\n}\nif (JSON.stringify(next) === JSON.stringify(state)) return null;\nmsg.payload = JSON.stringify(next);\nmsg.expectedState = msg.payload;\nreturn msg;",
    "outputs": 1,
    "noerr": 0,
    "initialize": "",
    "finalize": "",
    "libs": []
  },
